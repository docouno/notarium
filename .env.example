# Notarium config — copy to .env. The Docker stack passes this file straight
# through to the container (`.env` is never baked into the image).
#
# Notarium runs its own knowledge engine in-process (#69): markdown files are
# the truth, a derived SQLite index (FTS5) does search/graph. No external engine
# is required.

# Port the backend listens on (also the host port the stack publishes).
PORT=3000

# Auth (#10): 'password' (default — first boot serves the setup screen that
# mints the owner) or 'none' (single-principal: desktop, dev, trusted intranet).
# AUTH_MODE=password

# Reverse proxy IP trust: comma-separated IP/CIDR allowlist of DIRECT proxies.
# Unset is the secure default for rate limits: X-Forwarded-For is ignored. Never use
# a public/all-address range; make the proxy overwrite every forwarded header.
# TRUST_PROXY=172.18.0.0/16
# Stable OAuth issuer behind a proxy (recommended):
# PUBLIC_BASE_URL=https://notes.example.com

# --- Data ------------------------------------------------------------------
# ONE root; everything under it is derived in code (#101) — meta.db, engine/,
# jobs/ (+ jobs/imports) and spaces/. NONE of it is a required setting: leave the
# whole section commented out and the app runs on a writable default (/data in the
# image, ~/.local/share/notarium on a host). That is deliberate — an internal path
# that is required WILL eventually be forgotten, which is how export/import once
# shipped broken behind a green boot. See docs/architecture.md#data-root.
# DATA_DIR=/data
#
# The overrides below exist for real operator needs, not as configuration you are
# expected to fill in. Unset, each derives from DATA_DIR.
#
# Share state across instances / go HA — the one override worth having:
# META_DB_URL=postgres://user:pass@db:5432/notarium
# Move derived data to another disk (both regenerate if lost):
# ENGINE_DATA_DIR=/fast/engine
# JOBS_DATA_DIR=/big/jobs

# --- Spaces -----------------------------------------------------------------
# Zero-config: every space is a folder under <DATA_DIR>/spaces, minted at setup /
# from the UI (#99) — nothing to set. Point SPACES_ROOT elsewhere only if your
# notes live outside the data root. Setting it (or the default) enables creating
# spaces at runtime; an explicit topology below keeps the host operator-static.
# SPACES_ROOT=/notes
#
# For a bare (non-Docker) single-space run set instead:
#   ENGINE=notarium
#   NOTES_DIR=/abs/path/to/notes

# --- Search: vector/hybrid (optional) ---------------------------------------
# FTS5 full-text search always works with zero setup. Vector/hybrid search (#81)
# is an optional capability on a heavy native stack (onnxruntime + a local model,
# ~600MB RAM for bge-m3). Two independent switches:
#
#   1. INSTALL — is the native vector stack present in node_modules?
#      • Dev host: `make deps` (default) OMITS it (~660MB lighter, #200);
#        `make deps-vector` installs it. • The Docker image always ships it.
#   2. RUNTIME — VECTOR_SEARCH below. Code default is `on`; the dev overlay and the
#      published image default it to `off`. With the stack absent, `on` degrades to
#      FTS honestly (logs one line per space). So for local vector work you need
#      BOTH `make deps-vector` AND VECTOR_SEARCH=on.
# VECTOR_SEARCH=on
# EMBED_MODEL / EMBED_DIMENSIONS pick the tier (bge-m3 default vs compact e5-small);
# EMBED_CPU_MEM_ARENA=off bounds RAM on a tight host. See README → "Search and configuration".

# --- Docker (optional) ------------------------------------------------------
# Override the image reference used by docker compose / `make up`. Defaults to
# docouno/notarium:latest if unset.
# IMAGE=docouno/notarium
# TAG=latest
