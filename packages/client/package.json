{
  "name": "@notarium/package-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "check": "devkit-verify && pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "format:check": "prettier --check . \"!package.json\" \"!pnpm-lock.yaml\" \"!pnpm-workspace.yaml\" \"!dist/**\" \"!release/**\" \"!coverage/**\" \"!**/.worktrees/**\"",
    "format": "prettier --write . \"!package.json\" \"!pnpm-lock.yaml\" \"!pnpm-workspace.yaml\" \"!dist/**\" \"!release/**\" \"!coverage/**\" \"!**/.worktrees/**\"",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.mjs",
    "fix": "pnpm run format && eslint --max-warnings 0 --fix . && pnpm run format",
    "build": "tsc -p tsconfig.build.json && cp src/style.css dist/style.css"
  },
  "devDependencies": {
    "react-dom": "19.3.1",
    "react": "19.3.1",
    "@docouno/env": "0.5.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "devkit": {
    "sourceDirectories": [
      "src"
    ],
    "typecheckConfigs": [
      "tsconfig.json",
      "tsconfig.test.json"
    ],
    "boundaries": {
      "forbidCrossAppImports": true
    }
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "development": "./src/style.css",
      "default": "./dist/style.css"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@notarium/package-api-contract": "workspace:*"
  }
}
