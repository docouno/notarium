{
  "name": "@notarium/server",
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Notarium Fastify host: REST transport over a KnowledgeStore + static SPA serving",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/apps/server/main.ts",
    "admin": "tsx src/apps/server/commands/admin/main.ts",
    "backup": "tsx src/apps/server/commands/backup/main.ts",
    "restore": "tsx src/apps/server/commands/restore/main.ts",
    "build": "node --no-maglev ../../node_modules/tsup/dist/cli-default.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@notarium/contract": "*",
    "@notarium/core": "*",
    "@notarium/engine": "*",
    "archiver": "^8.0.0",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "stream-chain": "^4.2.5",
    "stream-json": "^3.5.0",
    "undici": "^7.29.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0",
    "zod": "^4.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/archiver": "^8.0.0",
    "@types/pg": "^8.20.0",
    "tsup": "^8.5.0"
  }
}
